<customUI xmlns="http://schemas.microsoft.com/office/2006/01/customui" onLoad="ribbon.OnAddinLoad">
    <ribbon startFromScratch="false">
        <tabs>
            <tab id="proofreadTab" label="文本校对">
                <group id="proofreadGroup" label="校对">
                    <button id="btnProofread" label="开始校对" onAction="ribbon.OnAction" getImage="ribbon.GetImage" visible="true" size="large"/>
                    <button id="btnTogglePane" label="校对面板" onAction="ribbon.OnAction" getImage="ribbon.GetImage" visible="true" size="large"/>
                </group>
            </tab>
        </tabs>
    </ribbon>
</customUI>
